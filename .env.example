# Copy to .env and fill in LLM_API_KEY. Everything else works as-is against
# the manifests in k8s/, assuming the port-forwards noted below.
#
# These values are for running the app as host processes. Running it inside
# the cluster instead uses k8s/app.yaml, which sets the same variables to
# in-cluster Service addresses.

# --- Inference -------------------------------------------------------------
# Every model call goes through LiteLLM. There is deliberately no
# direct-to-provider path: a call that bypasses the gateway also bypasses its
# budgets, rate limits, spend logging and metrics.
LLM_BASE_URL=http://litellm.agentops.local/v1

# The application's own virtual key, not the master key. Create one in the
# LiteLLM UI scoped to the local aliases only. Spend is attributed to it and
# it is refused once over budget.
LLM_API_KEY=sk-replace-me

LLM_MODEL=order-tracking-model

# Agent roles map to LiteLLM aliases (see model_list in k8s/litellm.yaml).
# supervisor and order_actions resolve to the qwen-agent engine (14B NVFP4);
# order_tracking and infrastructure to qwen-specialist (1.5B AWQ).
SUPERVISOR_MODEL_ID=supervisor-model
ORDER_TRACKING_MODEL_ID=order-tracking-model
ORDER_ACTIONS_MODEL_ID=order-actions-model
INFRASTRUCTURE_MODEL_ID=infrastructure-model
EMBEDDING_MODEL_ID=embedding-model

# --- Data ------------------------------------------------------------------
# One Postgres instance holds five logical databases; the app owns `agentlab`.
# kubectl -n agentops port-forward svc/postgres-db 5432:5432
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agentlab
POSTGRES_USER=agentlab
POSTGRES_PASSWORD=agentlab-local-password

# Graph checkpoints. TTL is 3 days from last activity, set in app/agent_graph.py.
# kubectl -n agentops port-forward svc/redis 6379:6379
REDIS_URL=redis://127.0.0.1:6379

# --- Durable actions -------------------------------------------------------
# kubectl -n agentops port-forward svc/temporal 7233:7233
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-workflows

# --- Identity --------------------------------------------------------------
# Must match the `iss` claim Keycloak stamps on tokens, so this stays a
# gateway hostname even when the app runs in-cluster.
OIDC_ISSUER=http://keycloak.agentops.local/realms/agentops
OIDC_AUDIENCE=agentops-app
# false falls back to body-supplied identity, which allows impersonation.
# Development only.
OIDC_REQUIRED=true

# --- Guardrails ------------------------------------------------------------
# Off. In its last configuration the 2B self-check model answered "block" to
# every input, including "hello", while the pod stayed healthy. Do not enable
# without an eval that includes benign cases.
NEMO_GUARDRAILS_ENABLED=false
NEMO_LLM_MODEL=nemo-safety-model
NEMO_LLM_BASE_URL=http://litellm.agentops.local/v1

# --- Conversation lifecycle ------------------------------------------------
# A conversation with no new turns for this long is summarised, embedded into
# pgvector, and closed by the background sweeper.
CONVERSATION_IDLE_SECONDS=300
